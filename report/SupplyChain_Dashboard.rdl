  <DataSets>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>XE_LOCAL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name=":pMarket">
            <Value>=Parameters!pMarket.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT category_name, market, product_name, SUM(sales) AS sales
FROM Supply_Chain
WHERE (:pMarket = 'All' OR market = :pMarket)
GROUP BY category_name, market, product_name</CommandText>
      </Query>
      <Fields>
        <Field Name="CATEGORY_NAME">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CATEGORY_NAME</DataField>
        </Field>
        <Field Name="MARKET">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>MARKET</DataField>
        </Field>
        <Field Name="SALES">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SALES</DataField>
        </Field>
        <Field Name="PRODUCT_NAME">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PRODUCT_NAME</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>XE_LOCAL</DataSourceName>
        <QueryParameters><QueryParameter Name=":pMarket"><Value>=Parameters!pMarket.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT order_month, SUM(profit) AS total_profit
FROM (
  SELECT TO_CHAR(TO_DATE(order_date, 'DD Month, YYYY', 'NLS_DATE_LANGUAGE=ENGLISH'), 'YYYY-MM') AS order_month,
         order_profit_per_order AS profit, market
  FROM supply_chain
)
WHERE (:pMarket = 'All' OR market = :pMarket)
GROUP BY order_month
ORDER BY order_month</CommandText>
      </Query>
      <Fields>
        <Field Name="ORDER_MONTH">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ORDER_MONTH</DataField>
        </Field>
        <Field Name="TOTAL_PROFIT">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TOTAL_PROFIT</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsMarket">
      <Query>
        <DataSourceName>XE_LOCAL</DataSourceName>
        <CommandText>SELECT 'All' AS market, 0 AS sort_no FROM dual
UNION ALL
SELECT DISTINCT market, 1 AS sort_no FROM Supply_Chain
ORDER BY sort_no, market</CommandText>
      </Query>
      <Fields>
        <Field Name="MARKET">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>MARKET</DataField>
        </Field>
        <Field Name="SORT_NO">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SORT_NO</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
